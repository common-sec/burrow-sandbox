# An agent / developer sandbox. `burrow up examples/envs/dev.env`, then `burrow exec dev`.
# Every key is listed in docs/DEFINITIONS.md. Images must be pinned by digest (or be localhost/).
NAME=dev
# curl's image: small, has a shell; use your own dev image here.
IMAGE=mirror.gcr.io/curlimages/curl:8.16.0@sha256:463eaf6072688fe96ac64fa623fe73e1dbe25d8ad6c34404a669ad3ce1f104b6
# The project folder, mounted at /work. On Windows: WORKSPACE="C:\Users\me\src\project"
WORKSPACE=.
WORKSPACE_MODE=rw
# The only hosts the sandbox's proxy lets through (HTTPS, port 443). *.domain = any subdomain.
ALLOW=pypi.org,files.pythonhosted.org,proxy.golang.org,sum.golang.org,registry.npmjs.org
# crun (default) or krun (experimental microVM, Linux with KVM only).
ENGINE=crun
MEMORY=4g
