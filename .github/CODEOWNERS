# Everything that pins or fetches third-party code is reviewed by the security team, so they are
# asked to review every Dependabot PR and every pin change. The team (created by J) must exist
# in the common-sec organisation and have write access to this repository.
go.mod                    @common-sec/security
go.sum                    @common-sec/security
/packaging/               @common-sec/security
/test/images/             @common-sec/security
/test/presets/            @common-sec/security
Cargo.toml                @common-sec/security
Cargo.lock                @common-sec/security
/scripts/                 @common-sec/security
.containerignore          @common-sec/security
/.github/                 @common-sec/security
