# Hermes Agent in a persistent sandbox: burrow run hermes --name dev, then burrow shell dev -- hermes
# Credentials: log in inside the sandbox; the token stays in its home volume (burrow-NAME-home),
# never on the host and never in this file. Secrets through the proxy are on the roadmap (0.3).
# ALLOW: the hosts the agent needs for its API and login, from the vendor's documentation
# (*unverified*: check them on first use). A sandbox file's ALLOW replaces this list.
# Hermes talks to whichever provider you configure: add its host in your sandbox file.
NAME=hermes
DESCRIPTION=Hermes Agent (Nous Research) sandbox (test preset)
IMAGE=localhost/burrow-test-hermes:dev
WORKSPACE_MODE=rw
NETWORK=proxy
ALLOW=openrouter.ai,api.openai.com,api.anthropic.com
