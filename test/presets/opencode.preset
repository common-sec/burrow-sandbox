# opencode in a persistent sandbox: burrow run opencode --name dev, then burrow shell dev -- opencode
# Credentials: log in inside the sandbox; the token stays in its home volume (burrow-NAME-home),
# never on the host and never in this file. Secrets through the proxy are on the roadmap (0.3).
# ALLOW: the hosts the agent needs for its API and login, from the vendor's documentation
# (*unverified*: check them on first use). A sandbox file's ALLOW replaces this list.
# opencode talks to whichever provider you configure: add its host in your sandbox file.
NAME=opencode
DESCRIPTION=opencode agent sandbox (test preset)
IMAGE=localhost/burrow-test-opencode:dev
WORKSPACE_MODE=rw
NETWORK=proxy
ALLOW=models.dev,opencode.ai,api.anthropic.com,api.openai.com
